{
  "mcpServers": {
    "agent-memory": {
      "type": "http",
      "url": "${user_config.memory_url}/mcp",
      "headers": {
        "X-Memory-User-Key": "${user_config.memory_key}",
        "X-Memory-Agent-Id": "${user_config.agent_id}",
        "Authorization": "Bearer ${user_config.platform_token}"
      }
    }
  }
}
