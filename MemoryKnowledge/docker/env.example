# team-knowledge: docker compose environment variables
# Usage:
#   cp docker/env.example docker/env.docker
#   edit docker/env.docker
#   docker compose --env-file docker/env.docker up -d --build
#   ./docker/smoke-test.sh --base-url http://127.0.0.1:8421

# Set this once the image is pushed to CSIG Hub (otherwise it's built locally)
# TEAM_KNOWLEDGE_IMAGE=zot.platform.weaversoft.io/apps/team-knowledge:0.1.0

TEAM_KNOWLEDGE_HOST_PORT=8421

# ── Required: the address cloud Agents use (with /v3); don't use the Docker service name ──
PUBLIC_URL=http://203.0.113.10:8421/v3

# ── Recommended: the TMC root address (for team-knowledge callbacks, without the /api/... path) ──
TMC_CALLBACK=http://203.0.113.10:8123

# Set separately on the TMC side (not in this file): KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421  (without /v3)

# ── Wiki extraction LLM routing ──
# LLM_MODE=proxy (default): goes through context_proxy (the llm_binding TMC pushes); no key below needed.
# LLM_MODE=custom       : calls your own endpoint directly; fill in LLM_API_KEY / LLM_BASE_URL.
LLM_MODE=proxy
LLM_MODEL=ep-your-endpoint-id
# Only for LLM_MODE=custom:
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://tokenhub.weaveraimaas.com/v1

# ── Wiki ingest concurrency (optional) ──
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3           # stage-1 concurrency within one wiki, 1–10
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5            # global LLM concurrency, 1–20

# ── ClickHouse tool-call logging (optional, off by default) ──
KNOWLEDGE_CLICKHOUSE_ENABLED=false
# KNOWLEDGE_CLICKHOUSE_URL=http://clickhouse:8123
# KNOWLEDGE_CLICKHOUSE_DATABASE=default
# KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
# KNOWLEDGE_CLICKHOUSE_USER=default
# When auth is enabled, inject the ClickHouse password in the runtime environment.
# KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
# KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
# KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
# KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ── Scheduled Code-Graph auto-sync (optional, off by default) ──
# When on, every SCAN_INTERVAL_MIN minutes it scans all ready code-graphs; a FIFO
# queue + worker pool pulls the latest git code and rebuilds the index. The same id is never queued twice.
# Observe: GET /v3/auto-sync/status | trigger manually: POST /v3/auto-sync/trigger
# KNOWLEDGE_AUTO_SYNC_ENABLED=true
# KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10      # 1~60
# KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3          # 1~20
