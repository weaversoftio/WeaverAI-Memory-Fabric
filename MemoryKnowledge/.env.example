# Knowledge Service configuration
# Usage: cp .env.example .env && edit .env
# .env is loaded automatically by `import 'dotenv/config'` at the top of src/config.ts

# ═══ HTTP Server ═══
PORT=8421
API_PREFIX=/v3
LOG_LEVEL=debug

# ═══ Service-to-service auth ═══
# Empty (default) = auth off, every /v3 endpoint open (only for local development).
# Non-empty = every endpoint outside the read-only allow-list (tools/*, wiki/code-graph queries, llm-binding status/list, etc.)
# requires `Authorization: Bearer <KNOWLEDGE_SERVICE_KEY>`.
# Must be set for production/shared deployments; the deploy/global-images start scripts generate it and hand it to the Panel.
# KNOWLEDGE_SERVICE_KEY=

# ═══ Data storage ═══
# Data root: git clones, wiki sources, BM25 indexes and SQLite all live here
KNOWLEDGE_DATA_DIR=./data
# SQLite database path (4 tables: knowledge_wiki / knowledge_code_graph / *_audit)
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ═══ LLM (required for wiki ingest, not used by code-graph) ═══
# LLM_MODE: the global default route (a per-instance llm_binding always wins over it)
#   proxy (default): goes through the cloud Proxy, billed with the knowledge-service key TMC pushes.
#                  KS doesn't need a local Proxy; without a binding it fails (no silent direct connection).
#   custom       : calls your own endpoint directly with LLM_BASE_URL/LLM_API_KEY below (BYO).
LLM_MODE=proxy
LLM_PROVIDER=custom
LLM_MODEL=Memory-Model
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# Only needed with LLM_MODE=custom; inject the LLM API credentials in the runtime environment.
LLM_BASE_URL=

# ═══ MCP Server (used only by src/mcp/server.ts) ═══
# The MCP server calls this service's API over HTTP; this sets the forwarding target
KNOWLEDGE_API_URL=http://localhost:8421
# KNOWLEDGE_API_TOKEN=optional-bearer-token

# ═══ Integration with the control plane (team-memory-control) ═══
# When deploying TMC + KS, these two must be set explicitly. Both default to empty in the code:
# - PUBLIC_BASE_URL must be an address Agents can reach, including /v3;
# - CALLBACK_URL must be the TMC root address only; the program appends /api/v1/knowledge/status-callback.
# For Docker deployments use the CLI: --public-url / --tmc-callback (see docs/deployment.md)
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8421/v3
TMC_CALLBACK_URL=http://localhost:8123

# Control-plane settings (not read by this service):
#   KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421

# ═══ Wiki ingest concurrency (optional) ═══
# Concurrent stage-1 LLM extractions within one wiki, default 3, clamped to 1–10
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3
# Global maximum LLM concurrency (extract + merge across all wikis), default 5, clamped to 1–20
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5

# ═══ ClickHouse tool-call logging (optional, off by default) ═══
# Only POST /v3/tools/call is recorded, into a tool_call_logs table with the same structure Memory/Skill use.
# Request bodies are recursively redacted and truncated to 512 bytes; a failed write doesn't affect Knowledge requests.
KNOWLEDGE_CLICKHOUSE_ENABLED=false
KNOWLEDGE_CLICKHOUSE_URL=http://127.0.0.1:8123
KNOWLEDGE_CLICKHOUSE_DATABASE=default
KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
KNOWLEDGE_CLICKHOUSE_USER=default
# When auth is enabled, inject the ClickHouse password in the runtime environment.
KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ═══ Scheduled Code-Graph auto-sync ═══
# Periodically scans every code-graph in the ready state; a FIFO queue + worker pool pulls the latest git
# and rebuilds the index. Off by default; when on, each repository syncs every max(single sync duration, SCAN interval).
# Observe: GET /v3/auto-sync/status | trigger manually: POST /v3/auto-sync/trigger
KNOWLEDGE_AUTO_SYNC_ENABLED=false
# scan interval (minutes), clamped to 1–60
KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10
# number of concurrent workers (how many repositories sync at once), clamped to 1–20
KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3
