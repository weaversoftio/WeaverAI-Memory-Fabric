# ═══════════════════════════════════════════════════════════
# Control Panel environment variable template
# Architecture: path A (stateless panel): entry src/index.ts goes straight to src/panel/
# Copy to .env and change as needed
#
# Design doc: docs/architecture/09-new-panel-control-backend-design.md
# API contract: docs/api/meta-api.openapi.yaml
# E2E tests: docs/architecture/10-panel-control-e2e-test-plan.md
# Post-deploy smoke: docs/architecture/11-smoke-meta-post-deploy.md
# ═══════════════════════════════════════════════════════════

# ── Service ──
HOST=0.0.0.0
PORT=8123

# ── Instance registry (JSON file path) ──
# Fields per item: id, name, gateway_endpoint, api_key (Gateway Bearer)
# First local start: copy it from the template and fill it in (the file is gitignored; never commit it)
#   cp config/metadata-instances.example.json config/metadata-instances.json
# Field reference: config/metadata-instances.README.md
METADATA_INSTANCES_CONFIG=./config/metadata-instances.json
METADATA_REMOTE_TIMEOUT_MS=15000

# ── Logging ──
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: pretty (local development) | json (production collection)
LOG_LEVEL=info
LOG_FORMAT=pretty

# ── Frontend static assets (served same-origin by the backend in production) ──
UI_DIST_DIR=./web/dist

# ── Knowledge Service (Wiki / Code-Graph, separate service :8421) ──
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421
KNOWLEDGE_AUTH_TOKEN=
KNOWLEDGE_TIMEOUT_MS=30000

# ==== Knowledge Service LLM binding (synced at startup) ====
# At startup, make sure KS has a knowledge-service LLM binding for every instance in the registry
# (KS /v3/internal/llm-binding/*): use the instance api_key as admin to find/create
# the hidden knowledge-service user, mint a user_key and push it to KS. Best-effort: a failure
# is only logged and doesn't block startup. Design in 09-new-panel-control-backend-design.md §4.2
KNOWLEDGE_LLM_BINDING_SYNC=true
# context proxy entry point the KS LLM binding uses (mode=proxy)
KNOWLEDGE_LLM_PROXY_BASE_URL=http://127.0.0.1:8096
# Note: the model isn't configured here; it's decided by KS's LLM_MODEL (default Memory-Model)

# ── Observability (Analytics) entry switch ──
# Whether the "production usage" page (menu/route) is visible. Its data source is the **kernel-side** ClickHouse
# tracking (MemoryCore analytics.clickhouse), unrelated to the PANEL_CLICKHOUSE_* audit reporting below.
# Off by default (conservative): deployments without analytics ClickHouse don't see the entry;
# once CH is connected, set true explicitly; the page still shows a runtime hint about CH reachability.
PANEL_FEATURE_ANALYTICS_ENABLED=false

# ── ClickHouse API call audit (optional) ──
# When on, the Panel writes every API call (user_key, endpoint, latency, etc.) into a CH table,
# for statistics such as cold-start import frequency and user activity. Without config it's skipped silently at zero cost.
# The table is created automatically (CREATE TABLE IF NOT EXISTS).
PANEL_CLICKHOUSE_ENABLED=false
PANEL_CLICKHOUSE_URL=
# PANEL_CLICKHOUSE_URL=http://clickhouse.example.com:8123
PANEL_CLICKHOUSE_DATABASE=default
PANEL_CLICKHOUSE_TABLE=panel_api_call_logs
PANEL_CLICKHOUSE_USER=default
PANEL_CLICKHOUSE_PASSWORD=
PANEL_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
PANEL_CLICKHOUSE_FLUSH_THRESHOLD=50
PANEL_CLICKHOUSE_TTL_DAYS=90
PANEL_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ── Login methods ──
# Default: user_key. Possible combinations: user_key, sso, oidc — e.g. user_key,sso
# user_key is the legacy login entry point; keep it.
PANEL_AUTH_MODE=user_key

# ── Enterprise SSO (only when PANEL_AUTH_MODE includes sso) ──
# Sensitive values go in the local .env only; never commit them to git.
# Session/encryption keys are generated and persisted by the Panel on first start (0600 file); they can't be configured.
PANEL_AUTH_SSO_APP_TOKEN=
# APP_URL: our panel's external address; Enterprise SSO redirects back here after authentication (must be an absolute URL, http or https).
# Note it must sit behind the Enterprise SSO gateway: the gateway injects the identity on the redirect as the x-enterprise-sso-identity header,
# which a direct connection to the panel doesn't get, so the Enterprise SSO flow can't complete.
PANEL_AUTH_SSO_APP_URL=
# Enterprise SSO login/logout page addresses. **Required** once Enterprise SSO is enabled (the source keeps no built-in defaults).
PANEL_AUTH_SSO_LOGIN_URL=
PANEL_AUTH_SSO_LOGOUT_URL=
PANEL_AUTH_SSO_PAAS_ID=

# Domain identifier written to core meta_users.auth_provider for external identities (optional).
# Writing and reading use the same value; if they differ it "writes into domain A and looks up domain B", failing silently.
# Defaults to local, matching Core's default (usually no need to set it).
# METADATA_EXTERNAL_AUTH_PROVIDER=local

# ── Enterprise SSO auto-provisioning ──
# After login the "auto-create user_key" option is always shown; no extra switch needed.
#
# Creating it on the server needs system_admin; the credential is always the **instance api_key** (single source,
# see design §12.3); there's no separate admin key setting.
# Deployment prerequisite: the instance api_key must resolve to a system_admin on the Core side,
# otherwise provisioning returns 401 (the panel shows SSO_PROVISION_FAILED).
# PANEL_AUTH_SSO_DEFAULT_TEAM_ID=

# ── Integration testing ──
# Gateway: http://127.0.0.1:8420
# Panel E2E: ./tests/panel/e2e-panel-meta.sh
