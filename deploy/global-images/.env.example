# ═════════════════════════════════════════════════════════════════════════════
# WAMF global images, local deployment - environment variable template
#
# Usage:
#   cp .env.example .env
#   # edit .env and replace REPLACE_ME with your own values
#   ./start-all.sh
#
# Two independent groups of settings:
#   MEMORY_*   → used by memory + memory-hub (the LLM for the internal memory/knowledge services)
#   PROXY_*    → used by the proxy (the upstream LLM user requests are forwarded to)
# The two groups can be the same, or point to completely different models/providers.
# ═════════════════════════════════════════════════════════════════════════════

# ── Image tags ───────────────────────────────────────────────────────────────
# Use images built from this repository, pinned to a commit tag, e.g.
#   zot.platform.weaversoft.io/apps/agent-memory-core:<commit>
#   zot.platform.weaversoft.io/apps/agent-memory-hub:<commit>
#   zot.platform.weaversoft.io/apps/agent-memory-proxy:<commit>
# (or your own local builds). Do not use the public agentmemory/* Docker Hub images:
# they are upstream builds, not this code.
MEMORY_CORE_IMAGE=REPLACE_ME
MEMORY_HUB_IMAGE=REPLACE_ME
PROXY_IMAGE=REPLACE_ME

# ── memory group: the LLM used internally by memory + memory-hub ──────────────
# Used for: memory's embed/summarize; knowledge's wiki ingest / summaries in memory-hub
MEMORY_LLM_BASE_URL=REPLACE_ME              # e.g. https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # e.g. sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # e.g. deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── proxy group: the upstream LLM the proxy forwards user requests to ─────────
# Used for: coding agents / clients call proxy:8096, and the proxy forwards here
PROXY_UPSTREAM_URL=REPLACE_ME               # e.g. https://api.deepseek.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME           # e.g. sk-xxxxxxxx (may differ from the memory group)
PROXY_UPSTREAM_MODEL=REPLACE_ME             # e.g. deepseek-chat

# ── Ports (the defaults work as is; change them here on local conflicts) ──────
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── Externally reachable knowledge address (needed by memory-hub) ─────────────
# Lets agents / the gateway reach the KS tools endpoints. Must include the /v3 prefix.
# Locally, host.docker.internal is used by default so containers can loop back to the host.
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

# ── Base URL shown in the panel's "client connection" card (local open-source deploy only) ──
# In the open-source deploy core and proxy run separately; coding-agent clients connect to the proxy, not core/gateway.
# This value is only used for display in the panel (e.g. the base URL copy card for CodeBuddy / Claude Code);
# the Panel backend → Kernel forwarding always uses REMOTE_INSTANCE_URL (=memory-core) and is not affected.
#
# When not set, the script detects the host's LAN IP (`hostname -I` / macOS `ipconfig getifaddr en0`)
# and builds `http://<lan-ip>:${PROXY_PORT}` — other people's machines can then connect with the URL from the card.
# Explicitly empty (="") falls back to the old gateway_endpoint behaviour.
# To set it explicitly (e.g. a public domain / a specific interface IP), uncomment the line below and fill it in:
# MEMORY_HUB_PROXY_PUBLIC_URL=http://192.168.1.100:8096

# ── Data volume names ────────────────────────────────────────────────────────
MEMORY_CORE_VOLUME=wamf-memory-core-data
PANEL_VOLUME=wamf-panel-data

# ── memory-core storage backend (optional, sqlite by default) ─────────────────
# sqlite  —— no dependencies, data lives in MEMORY_CORE_VOLUME (the open-source single-machine default, recommended to start)
# mongodb —— the data plane uses MongoDB: L0/L1/profile/skill documents + mongot native BM25 search.
#            Requires Mongo 7.0+ with mongot (Atlas or mongodb-atlas-local);
#            core probes the topology/mongot on first connect and fails init without mongot (no silent fallback).
#
# [Recommended] Experimental, off by default. To use mongo, don't change it here — just run
# ./start-all-mongo.sh, which writes MEMORY_CORE_STORE_MODE=mongodb into this file
# and reuses the whole start-all.sh flow (keep this line commented out).
# Only uncomment the line below if you've already enabled it, or want ./start-all.sh to use mongo directly:
# MEMORY_CORE_STORE_MODE=mongodb
#
# Option A: point to an external Mongo (Atlas / a self-hosted replica set with mongot) — fill in these two:
# MONGODB_ENDPOINT=mongodb://user:pass@your-mongo:27017/?directConnection=true
# MONGODB_DATABASE=wamf_memory
#
# Option B: leave MONGODB_ENDPOINT empty — the script starts a local atlas-local container on the same network
# (mongod + mongot in one, data persisted in the mongo-local-* volumes; stop-all.sh --purge cleans them up too):
# MONGO_LOCAL_IMAGE=mongodb/mongodb-atlas-local:8.3
# MONGO_LOCAL_CONTAINER=wamf-mongo-local
#
# Metadata (meta_* teams/users/agents/tasks/ACL) backend:
#   auto (default) —— follows MEMORY_CORE_STORE_MODE: in mongo mode it goes into the same Mongo
#                  (database wamf_metadata_<instance>, separate from the data plane's wamf_memory);
#                  metadata uses multi-document transactions, so a replica set is required (single-node atlas-local RS is fine).
#   sqlite      —— force metadata to stay in sqlite inside the core container volume (old behaviour)
# MEMORY_CORE_METADATA_BACKEND=auto
# To point metadata at a different Mongo cluster, override separately:
# WAMF_METADATA_MONGO_URI=mongodb://user:pass@other-mongo:27017/

# ── memory-core internal credential ──────────────────────────────────────────
# The admin credential for the gateway's Bearer layer.
#   empty (default) —— Bearer gate off (zero-config local use; the proxy's auth/sessionInit
#                    only works against memory-core with this setting, see the top of start-memory-core.sh)
#   non-empty       —— every request must send `Authorization: Bearer <key>`; the proxy currently
#                    doesn't send that header, so the proxy's auth/sessionInit fails
# For production, enable a non-empty key only after this is fixed on the proxy side.
MEMORY_CORE_GATEWAY_API_KEY=

# Panel ↔ Knowledge service-to-service auth key.
#   empty (default) —— the start script generates a random value (ks-svc-*) and writes it back to this file;
#                    the same value is injected into the memory-hub container twice: KNOWLEDGE_SERVICE_KEY
#                    (checked by Knowledge) + KNOWLEDGE_AUTH_TOKEN (sent by Panel).
#   set explicitly  —— the script respects the existing value (distribute it yourself for multi-machine / external orchestration).
# Once set, Knowledge's write/admin endpoints (wiki ingest, llm-binding/set, etc.) require
# `Authorization: Bearer <key>`; tools/* and read-only query endpoints stay open.
KNOWLEDGE_SERVICE_KEY=

# Private git repos for Code Graph (optional). One read-only credential for every repo
# under the URL prefix; it is sent as an HTTP header and never stored in the repo URL.
# Bitbucket access tokens (repository / project / workspace) use the username x-token-auth.
# Leave all three empty to allow public repos only.
KNOWLEDGE_GIT_AUTH_URL_PREFIX=
KNOWLEDGE_GIT_AUTH_USERNAME=
KNOWLEDGE_GIT_AUTH_TOKEN=

# Admin username (used by the first init-admin). The start script generates a random sk-mem- user_key on first run
# and saves it to ./.admin-key — later scripts / claude-proxy read it from there, no manual entry needed.
MEMORY_CORE_ADMIN_USERNAME=admin

# ── Memory prompt mode ──────────────────────────────────────────────────────
# Selects the prompt family of the L1/L2/L3 pipeline:
#   code (default) —— for engineering / team collaboration: extracts project facts / tasks / decisions / SOPs / taboos
#   chat           —— for personal conversation / teaching / chit-chat: extracts persona / episodic / instruction memories
# Note: in code mode pure small talk may extract 0 memories (the LLM finds no engineering content worth keeping).
MEMORY_PROMPT_MODE=code
